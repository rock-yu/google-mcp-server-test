{
  "source": "Reviewed local-only Drive MCP extension",
  "commonSchemas": {
    "stringResult": {
      "type": "object",
      "properties": {
        "result": {"type": "string"}
      },
      "required": ["result"]
    }
  },
  "commonAnnotations": {
    "destructiveDriveWrite": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  "tools": {
    "update_file": {
      "inputSchema": {
        "type": "object",
        "properties": {
          "file_id": {"type": "string"},
          "title": {
            "anyOf": [{"type": "string"}, {"type": "null"}],
            "default": null
          },
          "parent_id": {
            "anyOf": [{"type": "string"}, {"type": "null"}],
            "default": null
          }
        },
        "required": ["file_id"]
      },
      "outputSchemaRef": "stringResult",
      "annotationsRef": "destructiveDriveWrite"
    }
  }
}
